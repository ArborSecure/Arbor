# ============================================================
#  Arbor — environment configuration
#  Copy this file to .env and fill in your values
#  (deploy/install.sh does this for you and fills in the secrets).
#
#  HOW IT WORKS
#  server.js imports env.js first, which loads the .env sitting
#  next to the app on any Node version, regardless of the working
#  directory it was started from. Real environment variables
#  always override .env values. Just run:  node server.js
#
#  PRODUCTION MODE: deploy/arbor.service sets NODE_ENV=production.
#  The server then REFUSES TO START (and says why) unless
#  DATABASE_URL, PUBLIC_ORIGIN (https://), TRUST_PROXY and
#  ARBOR_DATA_DIR are set, no test-only override is set, and the
#  server salt matches the one the database was created with.
# ============================================================


# ------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ------------------------------------------------------------

# Postgres (production runs on Postgres only).
#DATABASE_URL=postgres://arbor:PASSWORD@127.0.0.1:5432/arbor
# TLS to the database: with DATABASE_URL the default is VERIFIED TLS. For a database
# on the same machine set PGSSL=disable. Otherwise: verify (default), or no-verify
# (encrypts but does NOT check the certificate — avoid). PGSSLROOTCERT=/path/ca.pem
# (or PGSSLCA=<inline PEM>) for a private CA.
#PGSSL=disable
#PGSSLROOTCERT=
# Without DATABASE_URL: PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE
# (defaults localhost / 5432 / arbor / "" / arbor) with STORAGE_BACKEND=postgres.
# Connection pool size (default 20):
#PG_POOL_MAX=20

# The public https origin of this server (no trailing slash). Payment return pages
# and the HTTPS redirect are built from it — never from the request's Host header.
#PUBLIC_ORIGIN=https://arbor.example.com

# Arbor runs behind a TLS reverse proxy (deploy/Caddyfile or deploy/nginx.conf).
# "1" = trust exactly one proxy hop, so rate limits see real client addresses.
# Only leave it unset for a server that is directly on the internet (it can't be
# in production: Arbor itself doesn't do TLS).
TRUST_PROXY=1

# Where the server keeps its data files (server-salt.json, vapid.json — when they
# aren't set below) and backups. Must be writable by the service user.
#ARBOR_DATA_DIR=/var/lib/arbor

# Redirect plain-http requests to https (Caddy already does this; harmless to set).
#FORCE_HTTPS=1


# ------------------------------------------------------------
# SECRETS — deploy/install.sh creates these once. KEEP THEM.
# ------------------------------------------------------------

# Server salt: every public id and username hash is derived from it. It must NEVER
# change once accounts exist — the server refuses to start with a different one.
# If unset, one is created in ARBOR_DATA_DIR/server-salt.json (back it up!).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#SERVER_SALT=

# Push notification (VAPID) keys. If unset, a pair is created in
# ARBOR_DATA_DIR/vapid.json. Changing them breaks every existing push subscription.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=

# Encrypts the nightly backups (scripts/backup.mjs refuses to run without it).
# 16+ characters. COPY IT TO A PASSWORD MANAGER — without it the backups can't be
# restored if this server is lost.
#ARBOR_BACKUP_KEY=
# Backup location (default ARBOR_DATA_DIR/backups — copy it OFF the server too),
# how many to keep (default 14), and the pg_dump binary (default: on PATH; same
# major version as the database or newer).
#ARBOR_BACKUP_DIR=/var/lib/arbor/backups
#ARBOR_BACKUP_KEEP=14
#PG_DUMP=/usr/bin/pg_dump
# Only on purpose: write the database dump UNENCRYPTED and skip the secrets bundle.
#ARBOR_BACKUP_ALLOW_PLAINTEXT=1

# Operator dashboard (/api/admin/*, /admin). Unset = the whole admin surface is
# off (404). Use a long random value; it is accepted from a header only.
#ADMIN_TOKEN=


# ------------------------------------------------------------
# STRIPE (card payments)
# All three are needed for Stripe to work.
# ------------------------------------------------------------

# Your secret key from Stripe Dashboard → Developers → API keys
# Use sk_test_... while testing, sk_live_... in production.
#STRIPE_SECRET_KEY=sk_test_...

# The price_... ID from your $20/month recurring price.
# Dashboard → Product catalog → your product → Prices section → copy price_... ID
#STRIPE_PRICE_ID=price_...

# Signing secret for webhook verification.
# Dashboard → Developers → Webhooks → your endpoint → Signing secret (whsec_...)
# NOTE: the Stripe CLI generates its OWN whsec_ for local testing —
# use that one while running `stripe listen`, swap it for the dashboard
# one when you deploy.
# Subscribe the endpoint to: checkout.session.completed, invoice.paid,
# charge.refunded, charge.dispute.created (the last two take back the premium
# days of a refunded/disputed payment). Optional: customer.subscription.updated
# and customer.subscription.deleted keep a cancel done in Stripe itself in sync.
#STRIPE_WEBHOOK_SECRET=whsec_...


# ------------------------------------------------------------
# MONERO (XMR payments via NOWPayments — hosted, no node needed)
# Sign up at nowpayments.io, add your XMR wallet, enable XMR
# in Coin Settings, then generate both keys below.
# ------------------------------------------------------------

# API key from NOWPayments dashboard → API Settings
#NOWPAYMENTS_API_KEY=

# IPN Secret Key from NOWPayments dashboard → Payment Settings
# (separate from the API key — used to verify webhook signatures)
#NOWPAYMENTS_IPN_SECRET=

# Set to "true" to use the NOWPayments sandbox
# (account-sandbox.nowpayments.io) instead of production.
#NOWPAYMENTS_SANDBOX=false


# ------------------------------------------------------------
# PLANS
# ------------------------------------------------------------

# Max members per network on the free plan. Default: 20.
#FREE_TREE_LIMIT=20

# "1" = donation-only mode: no free-plan member limit, nothing is ever archived for
# payment. (Every network is still capped at 2,000 members — the largest audience a
# message can carry.)
#PAYWALL_DISABLED=1

# Accounts created before this date (YYYY-MM-DD, e.g. the paywall launch day) get
# lifetime free Premium. Applied at every start; safe to leave set.
#GRANDFATHER_BEFORE=2026-10-01


# ------------------------------------------------------------
# NETWORKING AND LIMITS
# ------------------------------------------------------------

# Port to listen on. Default: 3000.
#PORT=3000

# Comma-separated list of allowed CORS origins. Only needed if
# you're running the frontend on a different domain than the API.
# Example: https://app.example.com,https://www.example.com
#ALLOWED_ORIGINS=

# Signup anti-spam proof-of-work (adaptive). Since there's no phone/email gate,
# account creation requires the client to solve a hash puzzle. Difficulty is in
# leading zero bits (~2^bits hashes per account). It ESCALATES automatically:
#   POW_SIGNUP_BITS         calm-state floor (default 16, ~0.5-2s in-browser)
#   POW_MAX_BITS            cap under attack (default 21)
#   POW_ESCALATE_THRESHOLD  successful signups per window before escalating (30)
#   POW_ESCALATE_WINDOW_MS  rate window (default 10 min)
# Each doubling of the signup rate over the threshold adds ~2 bits (4x cost), so
# a flood gets exponentially expensive while normal signups stay cheap. Set the
# floor to 0 to disable PoW entirely. POW_TTL_MS bounds challenge validity.
#POW_SIGNUP_BITS=16
#POW_MAX_BITS=21
#POW_ESCALATE_THRESHOLD=30
#POW_ESCALATE_WINDOW_MS=600000
#POW_TTL_MS=600000

# Per-IP limits: login/auth attempts per 15 minutes (default 40) and new
# identities created per minute (default 20).
#AUTH_IP_PER_15MIN=40
#REGISTER_IP_PER_MIN=20

# Identities per account (default 60) and networks one account may found (default 10).
#MAX_NODES_PER_ACCOUNT=60
#MAX_ROOTS_PER_ACCOUNT=10


# ------------------------------------------------------------
# CALLS (TURN / STUN) — see TURN-SETUP.md
# ------------------------------------------------------------

# TURN relay URL(s), comma-separated. A TURN relay necessarily sees both call
# parties' IP addresses (it cannot read the media). Self-host coturn.
#TURN_URL=turn:your-server.com:3478
# RECOMMENDED: coturn `use-auth-secret` with the same `static-auth-secret` here —
# every call gets short-lived credentials (TURN_TTL_SEC, default 7200 s).
#TURN_SECRET=
#TURN_TTL_SEC=7200
# Legacy alternative: one static username/password for everyone (anyone who sees
# it can use your relay until you change it).
#TURN_USERNAME=arbor
#TURN_CREDENTIAL=your-turn-password

# STUN servers (comma-separated). If unset, public Google STUN is used, which
# sees callers' reflexive (public) IPs. Point this at your own coturn for a call
# path that exposes IPs to nobody outside your infrastructure.
#STUN_URLS=stun:your-server.com:3478

# Allow a THIRD-PARTY public TURN relay as a fallback when TURN_URL is unset.
# Off by default: a public relay would see participant IPs. Set to 1 only if you
# accept that trade-off for call reliability on symmetric-NAT/CGNAT networks.
#ALLOW_PUBLIC_TURN=1


# ------------------------------------------------------------
# DATA RETENTION AND STORAGE
# ------------------------------------------------------------

# Delete relayed messages older than N days. Default (unset): 90.
# 0 = keep forever (not recommended: storage then grows without bound).
# Attachments never outlive this window either.
#MESSAGE_RETENTION_DAYS=90
# Premium networks keep this many days of history (default 365).
#PREMIUM_RETENTION_DAYS=365

# Per-account storage caps (bytes). A send / upload that would go over is
# refused with HTTP 413 until older messages expire or are deleted.
#MAX_MESSAGE_BYTES_PER_ACCOUNT=268435456
#MAX_ATTACHMENT_BYTES_PER_ACCOUNT=2147483648
# Media per identity, free / Premium (defaults 300 MB / 500 MB) — the storage bar.
#MAX_ATTACHMENT_BYTES_PER_NODE=314572800
#MAX_ATTACHMENT_BYTES_PER_NODE_PREMIUM=524288000
# Uploads one account may have in progress at once (default 3).
#MAX_UPLOADS_IN_FLIGHT_PER_ACCOUNT=3

# SERVER-WIDE ceilings (bytes; 0 = no limit). Per-account caps are ceilings, not
# reservations — these keep their SUM within your disk. Past a ceiling, new data of
# that kind is refused (HTTP 507) instead of filling the disk. Defaults (8 + 32 + 4
# GB) suit a ~58 GB disk; size them for yours, leaving room for Postgres itself.
#MAX_MESSAGE_BYTES_TOTAL=8589934592
#MAX_ATTACHMENT_BYTES_TOTAL=34359738368
#MAX_BACKUP_BYTES_TOTAL=4294967296
# Kept in memory (the service is capped at 1 GB): certificates (bytes, default
# 128 MB) and network-key boxes (count, default 300000).
#MAX_CERT_BYTES_TOTAL=134217728
#MAX_BOXES_TOTAL=300000

# Largest message ciphertext accepted, in base64 characters (default ~1 MB).
# Media travels as separate attachments, so text messages are far smaller.
#MSG_MAX_CT_CHARS=1048576
# Largest delivery page in bytes (default 2 MB; the app fetches the rest after).
#MSG_PAGE_BYTES=2097152


# ------------------------------------------------------------
# PUSH SERVICES
# ------------------------------------------------------------

# Push subscriptions are accepted only for the browser vendors' push services
# (Google FCM, Mozilla, Apple, Microsoft WNS). To allow another push service,
# list its host names here, comma-separated; a leading dot allows subdomains.
#PUSH_ENDPOINT_HOSTS=push.example.com,.push.example.org


# ------------------------------------------------------------
# TESTS ONLY — never set these on a real server (production refuses to start)
# ------------------------------------------------------------
# PREMIUM_DAY_MS (shortens a "day" of Premium), GRACE_MS_OVERRIDE (shortens the
# grace period), LOADTEST=1 (disables rate limits; only with a *loadtest* database).
